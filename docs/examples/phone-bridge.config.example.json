{
  "chatId": "oc_替换成你的会话",
  "allowedChatIds": [],
  "allowedSenderIds": [
    "ou_替换成你的open_id"
  ],
  "allowedSenderNames": [
    "你的名字"
  ],
  "prefix": "/pdf",
  "identity": "bot",
  "readIdentity": "bot",
  "httpHost": "127.0.0.1",
  "httpPort": 8791,
  "httpToken": "",
  "maxBodyBytes": 8388608,
  "outboxDir": "/Users/你的用户名/Desktop/pdf-outbox",
  "dshPath": "dsh",
  "profile": "headless",
  "dshArgs": [],
  "larkCliPath": "lark-cli",
  "pollMs": 5000,
  "timeoutMs": 300000,
  "maxInstructionChars": 2000,
  "maxAgeMs": 1800000,
  "allowedExtensions": [
    ".pdf",
    ".png",
    ".jpg",
    ".jpeg",
    ".txt",
    ".md"
  ],
  "maxFileBytes": 31457280,
  "maxFilesPerTask": 5,
  "statePath": "phone-bridge-state.json",
  "logPath": "phone-bridge.log",
  "downloadBaseUrl": "http://你的tailscale地址:19387",
  "downloadToken": "",
  "maxQueueLength": 3,
  "outboxRetentionDays": 14,
  "autoConfirm": true,
  "inboxDir": "",
  "inputTtlMs": 1800000,
  "maxInputBytes": 31457280,
  "presets": {
    "去除水印": "去掉这份文件的全部水印：先用 pdf_watermark 扫描；对页眉类候选（置信度 0.7）执行 remove；无法移除的页说明原因。**改完必须核对页数与原文件一致**（不许多页也不许少页，少了就说明删错了，要停下来报告）。产物写到 outbox，命名以我消息里写的要求为准。",
    "拆分试卷与答案": "把这份文件按「试卷」与「答案」拆成两份 PDF，写到 outbox。**只产出这两份**。命名以我消息里写的要求为准。拆分后**必须核对**：①两份页数相加等于原文件页数；②「试卷」那份是题目（选择/填空/大题，没有参考答案）；③「答案」那份是参考答案与解析。若页数对不上、或内容与名字颠倒（答案里是题目、试卷里是答案），**停下来报告，不要交付**。",
    "去除水印并拆分试卷与答案": "先把这份文件的全部水印去掉（pdf_watermark 扫描 → 页眉类候选置信度 0.7 执行 remove），**然后直接拆成两份**，产物**只有两份**：去水印后的试卷 + 去水印后的答案。**不要再单独输出一份\"仅去水印\"的文件**（那两份本身就已经是去水印的）。命名以我消息里写的要求为准。交付前**必须核对**：①两份页数相加等于原文件页数（去水印不该改变页数）；②「试卷」那份是题目；③「答案」那份是参考答案与解析；④ 内容与文件名必须一致，**不许弄反**。任一条不满足就停下来报告，不要交付。"
  },
  "defaultPreset": "",
  "autoPresetDelayMs": 60000,
  "presetFields": {
    "去除水印": [
      {
        "key": "out",
        "label": "去水印后的文件名",
        "suffix": "-去水印"
      }
    ],
    "拆分试卷与答案": [
      {
        "key": "paper",
        "label": "试卷文件名",
        "suffix": "-试卷"
      },
      {
        "key": "answer",
        "label": "答案文件名",
        "suffix": "-答案"
      }
    ],
    "去除水印并拆分试卷与答案": [
      {
        "key": "paper",
        "label": "试卷文件名（去水印）",
        "suffix": "-试卷"
      },
      {
        "key": "answer",
        "label": "答案文件名（去水印）",
        "suffix": "-答案"
      }
    ]
  }
}
