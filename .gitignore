# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
# lib/ is generated from src/ via `npm run build`
# lib/   ← 已放出：构建产物随仓库发布（clone 即可用）
dist/
build/

# Testing & Coverage
coverage/
*.lcov
.nyc_output

# Generated test fixtures
# `test/fixtures/make-fixtures.mjs` rebuilds these on demand (`ensureFixtures()`),
# so the binaries are caches, not sources.
test/fixtures/*.pdf
test/fixtures/*.png

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

